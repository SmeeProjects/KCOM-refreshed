<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>KiwisCoOpMod.Program</StartupObject>
    <ApplicationIcon>kcom.ico</ApplicationIcon>
    <AssemblyName>KiwisCoOpMod</AssemblyName>
    <RootNamespace>KiwisCoOpMod</RootNamespace>
    <IsPublishable>False</IsPublishable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Kiwi's Co-Op Mod for Half-Life: Alyx</Product>
    <Description>Play Half-Life: Alyx cooperatively with up to 16 players!</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="kcom.ico" />
  </ItemGroup>

  
	<ItemGroup>
    <BaseLuaScripts Include="$(ProjectDir)base_scripts\**\*.*" />
	<BaseCheckpoints Include="$(ProjectDir)base_checkpoints\**\*.*" />
	<GameAddon Include="$(ProjectDir)..\WorkshopAddon\game\hlvr_addons\kiwimp_alyx\**\*.*" />
 	</ItemGroup>
	<Target Name="CopyDLLs" AfterTargets="Build">
		<MakeDir Directories="$(ProjectDir)bin\$(Configuration)\scripts" />
		<Copy SourceFiles="@(BaseLuaScripts)" DestinationFiles="$(ProjectDir)bin\$(Configuration)\scripts\%(RecursiveDir)%(Filename)%(Extension)" />

		<MakeDir Directories="$(ProjectDir)bin\$(Configuration)\checkpoints" />
		<Copy SourceFiles="@(BaseCheckpoints)" DestinationFiles="$(ProjectDir)bin\$(Configuration)\checkpoints\%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- The game addon, for File > Install Addon and install-addon.ps1 (W9). -->
		<RemoveDir Directories="$(ProjectDir)bin\$(Configuration)\addon" />
		<Copy SourceFiles="@(GameAddon)" DestinationFiles="$(ProjectDir)bin\$(Configuration)\addon\kiwimp_alyx\%(RecursiveDir)%(Filename)%(Extension)" />
		<Copy SourceFiles="$(ProjectDir)..\tools\install-addon.ps1" DestinationFolder="$(ProjectDir)bin\$(Configuration)" />

		<!-- NLua, KeraLua and Lua's native DLL as NuGet resolved them, whatever their versions (W3). -->
		<Copy SourceFiles="@(RuntimeCopyLocalItems)" Condition="('%(NuGetPackageId)' == 'NLua' Or '%(NuGetPackageId)' == 'KeraLua') And '%(Extension)' == '.dll'" DestinationFolder="$(ProjectDir)bin\$(Configuration)\libraries" />
		<Copy SourceFiles="@(RuntimeTargetsCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'KeraLua' And '%(RuntimeIdentifier)' == 'win-x64' And '%(AssetType)' == 'native'" DestinationFolder="$(ProjectDir)bin\$(Configuration)" />
	</Target>
	<ItemGroup>
	  <BaseLuaScripts Remove="base_scripts\gamemodes\campaign\campaign.lua" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLua" Version="1.6.0" />
    <PackageReference Include="Open.Nat" Version="2.1.0" />
    <PackageReference Include="Websocket.Client" Version="4.4.43" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KiwisCoOpModCore\KiwisCoOpModCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>