<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<ImplicitUsings>enable</ImplicitUsings>
	  <Product>Kiwi's Co-Op Mod - Half-Life: Alyx Gamemode</Product>
	  <Description>Play Half-Life: Alyx cooperatively with up to 16 players!</Description>
  </PropertyGroup>
	<Target Name="CopyDLLs" AfterTargets="Build">
		<Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFolder="$(ProjectDir)..\KiwisCoOpMod\bin\$(Configuration)\gamemodes" />
		<Copy Condition="'$(Configuration)' == 'Debug'" SourceFiles="$(TargetDir)$(ProjectName).pdb" DestinationFolder="$(ProjectDir)..\KiwisCoOpMod\bin\$(Configuration)\gamemodes" />

		<Message Text="Copied build files" Importance="High" />
	</Target>
	<ItemGroup>
	  <PackageReference Include="Fleck" Version="1.2.0" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\KiwisCoOpModCore\KiwisCoOpModCore.csproj" />
	</ItemGroup>
</Project>
