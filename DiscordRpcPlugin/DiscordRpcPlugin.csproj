<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<ImplicitUsings>enable</ImplicitUsings>
	  <Product>Kiwi's Co-Op Mod - Discord RPC Plugin</Product>
	  <Description>Share your Half-Life: Alyx session status on Discord!</Description>
  </PropertyGroup>
	<Target Name="CopyDLLs" AfterTargets="Build">
		<Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFolder="$(ProjectDir)..\KiwisCoOpMod\bin\$(Configuration)\plugins" />
		<Copy Condition="'$(Configuration)' == 'Debug'" SourceFiles="$(TargetDir)$(ProjectName).pdb" DestinationFolder="$(ProjectDir)..\KiwisCoOpMod\bin\$(Configuration)\plugins" />

		<!-- DiscordRPC.dll as NuGet resolved it, whatever its version or lib folder (W3). -->
		<Copy SourceFiles="@(RuntimeCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'DiscordRichPresence' And '%(Extension)' == '.dll'" DestinationFolder="$(ProjectDir)..\KiwisCoOpMod\bin\$(Configuration)\libraries" />
	</Target>
	<ItemGroup>
	  <PackageReference Include="DiscordRichPresence" Version="1.0.175" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\KiwisCoOpModCore\KiwisCoOpModCore.csproj" />
	</ItemGroup>
</Project>
